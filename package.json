{
  "name": "chatgpt-to-pdf-extension",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:static": "node scripts/validate-static.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "check": "npm run validate:static && npm run typecheck && npm run test && npm run build && npm run validate:release",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "katex": "0.18.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "0.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "@types/node": "26.4.1"
  }
}
